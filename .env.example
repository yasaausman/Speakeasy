# ── CALL-E (the phone layer) ────────────────────────────────────────────────
# Auth is an OAuth browser flow. For the real smoke test you authenticate once
# via the calle CLI (see README); the MCP client below then connects over OAuth.
CALLE_MCP_URL=https://seleven-mcp-sg.airudder.com/mcp/openagent_oauth
CALLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8090/callback
CALLE_OAUTH_SCOPE=openid email profile

# Where Speakeasy caches the OAuth tokens it obtains (kept out of git).
CALLE_TOKEN_PATH=.speakeasy/calle-oauth.json

# ── Translation (backend) ───────────────────────────────────────────────────
# Voice (STT/TTS) is native on-device iOS — no keys needed for that.
# The backend needs a translation provider to bridge EN <-> es/hi/ar.
# Provider is auto-selected: Gemini > OpenAI > passthrough (no key = text stays English).

# Gemini (preferred) — get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenAI (fallback, used only if GEMINI_API_KEY is empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
DEMO_LANG=es
# Default number the backend dials when the app doesn't specify one.
DEMO_TARGET_NUMBER=+15555550123
