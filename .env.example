# ── CALL-E (the phone layer) ────────────────────────────────────────────────
# Auth is an OAuth browser flow. For the real smoke test you authenticate once
# via the calle CLI (see README); the MCP client below then connects over OAuth.
CALLE_MCP_URL=https://seleven-mcp-sg.airudder.com/mcp/openagent_oauth
CALLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8090/callback
CALLE_OAUTH_SCOPE=openid email profile

# Where Speakeasy caches the OAuth tokens it obtains (kept out of git).
CALLE_TOKEN_PATH=.speakeasy/calle-oauth.json

# ── Language provider (user side only — NOT the call audio) ──────────────────
# Default: OpenAI for STT + translate + TTS. Not needed for Phase 0 / Phase 1.
OPENAI_API_KEY=

# Optional alternatives
GOOGLE_APPLICATION_CREDENTIALS=
ELEVENLABS_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
PORT=3000
DEMO_LANG=es
